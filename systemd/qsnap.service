[Unit]
Description=qsnap — QEMU/KVM snapshot and backup orchestration
After=network.target libvirtd.service
Requires=libvirtd.service

[Service]
Type=oneshot
# Disable systemd's default timeout — qsnap uses stall detection
# (output-file-growth monitoring) for long-running data transfers.
# A backup that is progressing correctly should never be killed by
# a fixed timeout.
TimeoutStartSec=0
ExecStart=/usr/bin/qsnap -c /etc/qsnap/qsnap.toml run
