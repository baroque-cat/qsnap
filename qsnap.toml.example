# qsnap configuration file
# Place at /etc/qsnap/qsnap.toml

# ── Global options ──────────────────────────────────────────────────────
#
# Global options can be placed at the top level (as shown below) or
# grouped under a [global] section.  Both formats are accepted:
#
#   # Top-level format (default):
#   compress = true
#   compression_type = "zstd"
#
#   # [global] section format (alternative):
#   [global]
#   compress = true
#   compression_type = "zstd"
#
# When both are present, top-level keys take precedence over [global]
# section keys.


# Directory for persistent state files (per-VM JSON).
state_dir = "/var/lib/qsnap/state"

# Lockfile path.  Defaults to "/var/lib/qsnap/qsnap.lock" when not
# configured — an exclusive flock is acquired before every mutating
# command (run, snapshot, backup, prune, reconcile, restore, fork).
# Read-only commands (list, stats, check, estimate) run without lock.
# Set to a custom path to override, or "off" to disable locking
# entirely.
# lockfile = "/run/qsnap.lock"

# Default snapshot chain length for all VMs (applies unless overridden
# at the VM level).  In the default hysteresis mode this is the trigger
# threshold H: the chain grows with no commits while N <= H, then the
# oldest N − L snapshots are merged down to the floor L
# (snapshot_preserve_min).  Set to a positive integer. Minimum: 1.
# Default: 72.
# snapshot_chain_length = 72

# Default target chain length for all backup targets (applies unless
# overridden at the VM or target level).  When the incremental backup
# chain for a target exceeds this count, qsnap creates a new FULL backup.
# target_chain_length = 100

# Default number of FULL backup generations to keep per target.
# After creating a new FULL, older generations beyond this count are
# removed.  Minimum: 1.
# target_keep_generations = 2

# Snapshot preservation floor / hysteresis collapse floor L — the newest
# N snapshots are never blockcommitted.  In hysteresis mode a collapse
# merges down to the newest N.  In steady mode the floor guarantees the
# newest N snapshots are never blockcommitted even when chain_length is
# exceeded.  Set to 0 to disable the floor.  Default: 24.
# snapshot_preserve_min = 24

# Snapshot retention mode (global default, VM-overridable):
#   "hysteresis" (default) — grow-to-threshold / collapse-to-floor.  The
#                chain grows with no commits while N <= snapshot_chain_length
#                (the trigger threshold H); once N > H the oldest N − L
#                snapshots are merged down to the floor L, where L =
#                snapshot_preserve_min.  The whole collapse is a SINGLE
#                uncapped bulk blockcommit completed within ONE run (one
#                `virsh blockcommit --base … --top …` segment job); there is
#                no per-run cap and no multi-run phase.  A long bulk job may
#                hold the lockfile, so an overlapping hourly run exits with
#                code 3 ("Lockfile is held by another qsnap instance") and
#                retries on the next tick.  Validation requires H > L >= 1.
#                Default band: H = 72, L = 24 → hourly snapshots for the
#                last 24 h are kept, older layers collapse occasionally.
#   "steady"     — keep the newest snapshot_chain_length snapshots and
#                blockcommit the excess every run (the pre-existing
#                count-based policy).
# snapshot_retention_mode = "hysteresis"

# Deferred blockcommit monitoring thresholds.  When the number or age of
# deferred blockcommits exceeds these values, qsnap logs WARNING or CRITICAL.
# deferred_warn_count = "5"
# deferred_crit_count = "10"
# deferred_warn_age = "7d"
# deferred_crit_age = "14d"

# ── Fault-tolerance & safety controls (global) ──────────────────────────
# T0/T1: Fast operations, ON by default — safe to keep enabled.
# T3:    Heavy operations, OFF by default — opt in explicitly.

# T0 — Remove stale .tmp/.partial files and NBD sockets before each run.
# auto_cleanup = true

# T0 — Number of rotated state file backups to keep (vm.json → .1 → .2).
# state_backup_count = 2

# T1 — Verify backing chain integrity before blockcommit (~1 second).
# chain_verify_before_commit = true

# T1 — Verify chain length decreased after blockcommit (~1 second).
# chain_verify_after_commit = true

# T3 — Deep check schedule for qsnap check --deep reporting.
# Accepted: "off" (default), "weekly", "monthly".
# Does NOT control the systemd timer — only used for schedule reporting.
# deep_check_schedule = "off"

# Compress full backups (global default, overridden per-VM/target).
# compress = true

# Compression algorithm for FULL backups (qemu-img convert -c -o
# compression_type=<type>).
#   "zstd" (default) — 11x faster than zlib, slightly larger files
#   "zlib"           — standard qcow2 compression (slower, smaller)
# Only effective when compress = true.
# compression_type = "zstd"

# qemu-img convert -m flag (parallel coroutines, range 1-8).
# convert_parallel = 4

# qemu-img convert -W flag (allow out-of-order writes: multiple write
# requests may be in flight and complete out of order).  QEMU recommends
# -W only for preallocated/raw block-device targets; on growable qcow2
# targets it may scatter allocation.
# convert_out_of_order = true

# Stall detection timeout for data-transfer commands (qemu-img convert).
# Duration string (e.g. "30m", "1h", "0s").  When the output file shows
# no growth for this duration, the process is killed.
# "0s" disables stall detection (falls back to fixed-timeout run()).
# backup_stall_timeout = "30m"

# When to create backups (global default): "always" (default — always
# transfer backups) or "onchange" (skip backup transfer when the source
# disk has not changed since the last backup to that target — queries
# the VM's active disk directly via IChangeDetector, independent of
# snapshot existence).  Inherited by VM and target levels.
# backup_create = "always"

# Maximum wall-clock time in seconds for a single blockcommit
# (virsh blockcommit --wait or qemu-img commit).  When exceeded, the
# command is killed and the outcome is classified as "unknown" (never
# as a definitive failure) — qsnap then reconciles against observed
# reality.  Default 1800 s (30 min).
# blockcommit_timeout = 1800

# ── Proactive free-space gate before backup transfers ──────────────────
#
# Before every FULL or incremental transfer, qsnap estimates the required
# space and checks the target filesystem via shutil.disk_usage.  Gating
# prevents starting transfers doomed to ENOSPC.

# free_space_check: "strict" (suspend target when free space is
#   insufficient, default), "warn" (log WARNING and proceed anyway), or
#   "off" (no check — reactive ENOSPC handling only).
# free_space_check = "strict"

# free_space_reserve: extra safety margin in bytes added to the
#   estimated transfer size.  Default: 0.
# free_space_reserve = 0

# free_space_factor: multiplier for the estimate (>= 1.0) to account for
#   compression, sparse allocation, and estimation inaccuracy.
#   Default: 1.0.
#   NOTE: the estimate is a heuristic; switching compression algorithms
#   (e.g. zstd ↔ zlib) changes the effective compression ratio and may
#   require adjusting this factor for accurate gating.
# free_space_factor = 1.0


# ── VM definitions ──────────────────────────────────────────────────────

[[vm]]
name = "debiantest"

# Default snapshot directory for all disks of this VM.  Individual disks
# may override it via their own snapshot_dir (see [[vm.disk]] below).
snapshot_dir = "/var/lib/libvirt/snapshots/debiantest"

# ── Disk definitions ───────────────────────────────────────────────────
# Each disk of the VM gets its own [[vm.disk]] section with a libvirt
# target device name and its own base qcow2 image.  A VM must define at
# least one disk; disk targets must be unique.  Multi-disk VMs add one
# [[vm.disk]] section per disk (vda, vdb, ...).  Every disk of a VM must
# resolve to a DISTINCT snapshot directory: give each additional disk its
# own snapshot_dir override (sharing one directory between disks is
# rejected at config parse time).
  [[vm.disk]]
  target = "vda"
  base_image = "/var/lib/libvirt/images/debiantest.qcow2"
  # Optional per-disk snapshot directory override (inherits the VM-level
  # snapshot_dir when omitted):
  # snapshot_dir = "/fast-nvme/snaps/debiantest-vda"

# Override snapshot creation mode: "always" (default) or "onchange"
# snapshot_create = "onchange"

# Use --quiesce flag when creating snapshots (requires qemu-guest-agent
# installed in the VM).  Useful for filesystem-consistent snapshots.
# snapshot_quiesce = false

# Lifecycle mode for merging snapshots back into the base image (adaptive):
#   "virsh"    — default.  While the VM runs: live commits of non-active
#                layers via virsh blockcommit; only the active layer is
#                deferred (reason "vm_running").  When the VM is shut off:
#                offline commits via qemu-img; the XML-referenced tip
#                overlay is excluded (reason "active_layer") so the domain
#                stays bootable.  Deferred entries drain automatically on
#                later runs.
#   "qemu-img" — offline-only.  Never commits while the VM runs (qemu-img
#                writing into the base image of a live chain is unsafe);
#                defers everything until the VM is shut off, then commits
#                via qemu-img (same tip-exclusion rule).
# lifecycle_mode = "virsh"

# Change detection mode — used by both snapshot_create="onchange" and
# backup_create="onchange" to detect disk changes:
#   "allocation-map"   — compare qemu-img map allocated regions (default)
#                        catches zero-fill, fstrim, and region redistribution
#   "allocation-size"  — compare qemu-img info actual-size (faster but
#                        less sensitive)
# change_detection_mode = "allocation-map"

# Disks are defined via [[vm.disk]] sections above (one per disk).  There
# is no separate disk list — each [[vm.disk]] names its target device.

# Override snapshot chain length for this VM
# snapshot_chain_length = 336

# Override target chain length for this VM's targets
# target_chain_length = 200

# Override number of FULL backup generations to keep for this VM's targets
# target_keep_generations = 3

# Override snapshot preservation floor for this VM (inherits from global
# when unset).  0 = inactive (default), positive N = keep newest N snapshots.
# snapshot_preserve_min = 24

# Override snapshot retention mode for this VM (inherits from global when
# unset): "hysteresis" (default) or "steady".  In hysteresis mode this VM's
# snapshot_chain_length becomes the trigger threshold H and
# snapshot_preserve_min the collapse floor L (H > L >= 1 required).
# snapshot_retention_mode = "steady"

# ── Fault-tolerance & safety controls (per-VM) ──────────────────────────
# T2: Heavy operations, OFF by default — enable per-VM for critical VMs.

# T2 — Run qemu-img check after blockcommit on shut-off VMs (deferred).
# blockcommit_deep_verify = false

  # ── Backup engine options (per-VM, overrides global defaults) ─────────
  #
  # These options are inherited by every target of this VM.  Each target
  # may further override them individually.  Resolution order:
  # global → VM → target (more specific wins).
  #
  # Compress full backups for this VM (default: true).
  # compress = true
  #
  # Compression algorithm for FULL backups:
  #   "zstd" (default) — 11x faster, slightly larger files
  #   "zlib"           — slower, standard qcow2 compression
  # Only effective when compress = true.
  # compression_type = "zstd"
  #
  # qemu-img convert parallel coroutines (1-8, default: 4).
  # convert_parallel = 4
  #
  # qemu-img convert out-of-order writes (default: true).
  # convert_out_of_order = true
  #
  # Stall detection timeout for data-transfer commands.
  # Duration string (e.g. "30m", "1h").  "0s" disables stall detection.
  # backup_stall_timeout = "30m"
  #
  # Post-transfer verification mode:
  #   "metadata" (default) — qcow2 format + corrupt-bit check
  #   "check"              — metadata + qemu-img check
  #   "compare"            — metadata + check + qemu-img compare
  #   "off"                — no verification
  # verify = "metadata"

  # ── Backup targets ───────────────────────────────────────────────────
  # Backups use NBD dirty-block extraction via checkpoint (bitmap mode).
  # libvirt >= 7.2 and python3-libnbd are hard requirements.
  [[vm.target]]
  path = "/mnt/backup/debiantest"

  # Override target chain length for this target only
  # target_chain_length = 150

  # Override number of FULL backup generations to keep for this target only
  # target_keep_generations = 4

  # Compress full backups.  When true, FULL backups are created via
  # qemu-img convert with compression.  Default: true (inherited from
  # global → VM → target).
  # compress = true

  # Compression algorithm (inherited from global → VM → target).
  # "zstd" (default) — 11x faster than zlib.  "zlib" — standard qcow2.
  # Only effective when compress = true.
  # compression_type = "zstd"

  # qemu-img convert -m flag (parallel coroutines, range 1-8).
  # convert_parallel = 4

  # qemu-img convert -W flag (out-of-order writes).
  # convert_out_of_order = true

  # Stall detection timeout (inherited from global → VM → target).
  # Duration string like "30m", "1h", "0s" (disables stall detection).
  # backup_stall_timeout = "30m"

  # When to create backups for this target: "always" (default — always
  # transfer) or "onchange" (skip transfer when the source disk has not
  # changed since the last backup to this target).  Inherited from
  # global → VM → target.
  # backup_create = "onchange"

  # Backup verification level:
  #   "metadata" — verify qcow2 format + structure (default)
  #   "check"    — metadata + qemu-img check
  #   "compare"  — metadata + check + chain-traversing qemu-img compare
  #   "off"      — no verification
  # (inherited from VM → target; VM defaults to "metadata")
  # verify = "metadata"

  # ── Backup retry controls (per-target) ───────────────────────────────
  # Retry transient backup failures with exponential backoff.
  # Transient errors: "Connection refused", "No route to host",
  # "timed out", "broken pipe", "EOF".
  # Non-retryable: "No space left on device", "Permission denied".
  # backup_retry_max = 3
  # backup_retry_base = "2s"


# ── Critical VM example (T2 deep verification enabled) ─────────────────
# Uncomment and adapt for VMs that require maximum safety.
#
# [[vm]]
# name = "critical-db"
# snapshot_dir = "/var/lib/libvirt/snapshots/critical-db"
# snapshot_create = "onchange"
# snapshot_preserve_min = 24       # collapse floor L — always keep newest 24 snapshots
# snapshot_quiesce = true
# blockcommit_deep_verify = true
#
#   [[vm.disk]]
#   target = "vda"
#   base_image = "/var/lib/libvirt/images/critical-db.qcow2"
#
#   [[vm.target]]
#   path = "/mnt/backup/critical-db"
#   backup_create = "onchange"     # skip transfer when disk unchanged
#   verify = "metadata"
#   compress = true
#   backup_retry_max = 5
#   backup_retry_base = "10s"


# ── Fork ────────────────────────────────────────────────────────────────
# qsnap fork creates a standalone qcow2 from a snapshot or backup:
#   qsnap fork myvm.20250713T1531 --output /mnt/vms/myvm-clone.qcow2
#   qsnap fork myvm.20250713T1531 --output /mnt/vms/myvm-clone.qcow2 prod-server
#
# qsnap restore replaces a stopped VM's disk with a flattened qcow2:
#   qsnap restore myvm.20250713T1531
#   qsnap restore myvm.20250713T1531 --dry-run
#   qsnap restore myvm.20250713T1531 --yes
